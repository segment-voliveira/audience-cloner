# Copy to .env and fill in. .env is gitignored.

# Segment Public API token (Workspace Settings > Access Management > Tokens).
# Needs read + write access to the Engage space.
SEGMENT_PUBLIC_API_TOKEN=

# Engage space id (app.segment.com URL: /spaces/<id>/, or Engage > Settings).
SEGMENT_SPACE_ID=

# Workspace region: us | eu
#   us -> api.segmentapis.com
#   eu -> eu1.api.segmentapis.com
SEGMENT_REGION=us

# Optional: bypass the region mapping with an explicit host. May include a scheme,
# which is useful for pointing the CLI at a local mock while testing.
# SEGMENT_API_HOST=api.segmentapis.com
